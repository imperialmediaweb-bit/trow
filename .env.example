# Throwbox AI - Environment Variables
# Copy to .env and fill in values

# ─── Database ────────────────────────────────────────────────
DB_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://throwbox:change_me@localhost:5432/throwbox

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_me_64_char_random_string
JWT_REFRESH_SECRET=change_me_another_64_char_string

# ─── Encryption ──────────────────────────────────────────────
ENCRYPTION_KEY=change_me_32_byte_hex_key

# ─── AI Providers ────────────────────────────────────────────
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
GOOGLE_AI_KEY=xxx

# ─── CAPTCHA ─────────────────────────────────────────────────
HCAPTCHA_SITE_KEY=xxx
HCAPTCHA_SECRET=xxx

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── S3 / Object Storage ────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=throwbox-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ─── Email Provider ──────────────────────────────────────────
# Inbound/outbound email provider. Supported: resend
EMAIL_PROVIDER=resend
# Resend API key (https://resend.com) — leave blank to disable
RESEND_API_KEY=
# Secret used to verify incoming Resend webhook signatures
RESEND_WEBHOOK_SECRET=

# ─── SMTP / Mail ─────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=25
MAIL_DOMAINS=throwbox.net,tmpmail.dev
# Built-in Node SMTP server for inbound mail (alternative to Resend Inbound).
# Set to true to listen for inbound SMTP directly in the backend.
ENABLE_SMTP_SERVER=false
# Password for authenticated/relay SMTP, if required by your provider
SMTP_PASS=
# Port the built-in SMTP server listens on when ENABLE_SMTP_SERVER=true
SMTP_LISTEN_PORT=2525

# ─── Admin Bootstrap ─────────────────────────────────────────
# First-boot admin account, created automatically on startup if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Security / Breach Checking ──────────────────────────────
# Have I Been Pwned API key for password breach checking (optional)
HIBP_API_KEY=

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
APP_URL=https://throwbox.net
API_URL=https://api.throwbox.net
